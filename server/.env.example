PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27018/rizqara_local
ADMIN_EMAIL=admin@example.com
# Generate a unique scrypt hash with: npm run admin:password
ADMIN_PASSWORD_HASH=
# Production should serve frontend and /api on the same origin.
ALLOWED_ORIGINS=http://localhost:3000
# Enable only behind a known single reverse proxy:
TRUST_PROXY=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_TRANSLATE_API_KEY=
# Put this on persistent private storage in production.
PRIVATE_UPLOAD_DIR=
# Optional email notifications; submissions are safely stored even without these.
# Setup: https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
